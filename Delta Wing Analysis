%% Local Function
function [T, a, p, rho] = isa_simple(h)
% Simple ISA evaluator for altitudes up to 20 km.
% h in meters.
    gamma = 1.4;
    R = 287.05287;
    g0 = 9.80665;

    if h <= 11000
        T0 = 288.15;
        p0 = 101325;
        L = -0.0065;
        T = T0 + L*h;
        p = p0 * (T/T0)^(-g0/(L*R));
    elseif h <= 20000
        T11 = 216.65;
        p11 = 22632.06;
        T = T11;
        p = p11 * exp(-g0*(h-11000)/(R*T));
    else
        error('isa_simple is only set up here for h <= 20 km.');
    end

    rho = p/(R*T);
    a = sqrt(gamma*R*T);
end
