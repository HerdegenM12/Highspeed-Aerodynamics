fprintf('Speed of sound   = %.3f m/s\n', a);
fprintf('Cruise Mach      = %.4f\n', M_cruise);
fprintf('Dynamic pressure = %.2f Pa\n', q);
fprintf('Required wing S  = %.4f m^2  (from C_L = %.3f)\n', S_req, CL_cruise);

% Build candidate table
results = [];
row = 0;
for im = 1:length(m_vals)
    for it = 1:length(tau_vals)
        for iL = 1:length(Lambda_deg)
            row = row + 1;
            CD_curve = squeeze(CD(im,it,iL,:))';
            CD_interp = interp1(M, CD_curve, M_cruise, 'pchip', 'extrap');

            AR_i = 4 / tand(Lambda_deg(iL));
            b_i = sqrt(AR_i * S_req);
            c_i = 2 * S_req / b_i;
            t_i = tau_vals(it) * c_i;
            r_i = m_vals(im) * c_i;
            D_wave_i = q * S_req * CD_interp;

            results(row).m = m_vals(im); %#ok<SAGROW>
            results(row).tau = tau_vals(it);
            results(row).Lambda_deg = Lambda_deg(iL);
            results(row).AR = AR_i;
            results(row).CD_cruise = CD_interp;
            results(row).S = S_req;
            results(row).b = b_i;
            results(row).c = c_i;
            results(row).t = t_i;
            results(row).r = r_i;
            results(row).D_wave = D_wave_i;
            results(row).T_req = D_wave_i;
        end
    end
end

