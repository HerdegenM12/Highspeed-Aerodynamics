%% Choosing Delta Wing
% Cruise requirements
h_ft = 61000;
V_kmh = 1800;
mass_kg = 77000;
CL_cruise = 0.2;
g = 9.80665;

h_m = h_ft * 0.3048;
V = V_kmh / 3.6;
W = mass_kg * g;

% Standard atmosphere at altitude
[T, a, p, rho] = isa_simple(h_m);
M_cruise = V / a;
q = 0.5 * rho * V^2;
S_req = W / (q * CL_cruise);

fprintf('\nResults \n');
fprintf('Altitude         = %.0f ft (%.1f m)\n', h_ft, h_m);
fprintf('Velocity         = %.1f km/hr (%.3f m/s)\n', V_kmh, V);
